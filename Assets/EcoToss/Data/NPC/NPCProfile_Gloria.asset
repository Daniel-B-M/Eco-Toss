  m_Name: NPCProfile_Gloria
  m_EditorClassIdentifier: Assembly-CSharp::EcoToss.Feedback.NPCProfile
  displayName: "Do\xF1a Gloria"
  positiveReaction:
    portrait: {fileID: 21300000, guid: 878fb8cfe29d111489ef5f98da1227a9, type: 3}
    messages:
    - "\xA1Ay, qu\xE9 juicioso! Le voy a contar a todas."
    - "As\xED me gusta, vecino. \xA1Muy bien!"
    - "Mire qu\xE9 bonito, la plaza limpiecita."
  negativeReaction:
    portrait: {fileID: 21300000, guid: ea295dc96f41de642af5a66494ddc32b, type: 3}
    messages:
    - "Uy, \xBFvieron eso? Ya todo el barrio se va a enterar..."
    - "\xA1Ay, no! \xBFY eso d\xF3nde lo bot\xF3?"
    - "Tan mal... y despu\xE9s dicen que una es la chismosa."
  streakPortrait: {fileID: 21300000, guid: 1380568c3666f5849998cba7f5823bdb, type: 3}
